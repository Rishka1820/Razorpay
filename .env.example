# Storage (Vercel sets this when you add a Neon Postgres database)
DATABASE_URL=

# Razorpay TEST keys (Dashboard > Account & Settings > API keys, test mode). Leave empty to use the simulated checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Claude, for reading pasted chats and bill photos. Leave empty to use simple rules / a sample bill.
ANTHROPIC_API_KEY=

# Any long random string
SESSION_SECRET=
